Buffs: {
	DustyHazeDebuff: {
		DisplayName: Dusty Haze
		Description: Thick dust clouds your vision
	}
}

Items: {
	Seismograph: {
		DisplayName: Seismograph
		Tooltip: Displays the time until the next earthquake and its current phase
	}
}

Projectiles.FallingDebris.DisplayName: Falling Debris

Configs: {
	EarthquakeConfig: {
		DisplayName: Earthquake Config

		Headers: {
			Frequency: Frequency
			Magnitude: Magnitude
			Aftershocks: Aftershocks
			InterfaceAlerts: Interface & Alerts
			DamageDestruction: Damage & Destruction
		}

		AverageIntervalMinutes: {
			Label: Average Interval Minutes
			Tooltip:
				'''
				Average time between earthquakes, in minutes.
				The actual interval will randomly vary by ±30% from this value, so earthquakes aren't predictable by a fixed timer.
				'''
		}

		MaxMagnitude: {
			Label: Max Magnitude
			Tooltip:
				'''
				The maximum random magnitude that can occur (on a 10-point scale).
				The minimum magnitude is always 3.
				'''
		}

		EnableAftershocks: {
			Label: Enable Aftershocks
			Tooltip: Enable weak repeated tremors (aftershocks) after the main earthquake.
		}

		AftershockPeriodSeconds: {
			Label: Aftershock Period Seconds
			Tooltip: Approximate duration of the aftershock period after the main earthquake, in seconds.
		}

		ShowChatMessages: {
			Label: Show Chat Messages
			Tooltip: Show chat messages when an earthquake starts and ends.
		}

		ShowDebugButton: {
			Label: Show Debug Button
			Tooltip:
				'''
				Show an on-screen button to manually trigger an earthquake (useful for testing).
				Only visible to you - it doesn't affect other players' gameplay.
				'''
		}

		DebrisDamageMultiplier: {
			Label: Debris Damage Multiplier
			Tooltip: Overall damage multiplier for falling debris. 1.0 is standard damage.
		}

		ImmersiveAudioDucking: {
			Label: Immersive Audio Ducking
			Tooltip: Bonus - duck the background music during an earthquake to emphasize the rumble/roar.
		}
	}
}

InfoDisplays: {
	SeismographInfoDisplay: {
		DisplayName: Seismograph
		Idle: Seismograph: {0}
		Warning: Seismograph: RUMBLING! ({0})
		Main: EARTHQUAKE! (Magnitude {0}/10)
		Aftershock: Seismograph: aftershocks
		Unknown: Seismograph: --
	}
}

Chat: {
	QuakeStart: The ground begins to shake beneath your feet... Magnitude: {0}/10!
	AftershocksStarting: The main tremors are fading... but the ground may still shudder again.
	QuakeEnded: The earthquake has ended.
}

UI: {
	ToggleButtonLabel: EQ
	PanelTitle: Test Earthquake
	MagnitudeLabel: Magnitude:
	TriggerButton: Trigger!
	TriggerRequestedMessage: "[Test] Requested earthquake of magnitude {0}"
}
