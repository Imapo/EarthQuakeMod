Buffs: {
	DustyHazeDebuff: {
		DisplayName: Пыльная завеса
		Description: Густая пыль застилает обзор
	}
}

Items: {
	Seismograph: {
		DisplayName: Сейсмограф
		Tooltip: Показывает время до следующего землетрясения и его текущую фазу
	}
}

Projectiles.FallingDebris.DisplayName: Падающий обломок

Configs: {
	EarthquakeConfig: {
		DisplayName: Настройки землетрясения

		Headers: {
			Frequency: Частота землетрясений
			Magnitude: Магнитуда
			Aftershocks: Афтершоки
			InterfaceAlerts: Интерфейс и оповещения
			DamageDestruction: Урон и разрушения
		}

		AverageIntervalMinutes: {
			Label: Средний интервал (мин.)
			Tooltip:
				'''
				Среднее время между землетрясениями, в минутах.
				Реальный интервал будет случайно колебаться на ±30% от этого значения, чтобы землетрясения не были предсказуемыми по таймеру.
				'''
		}

		MaxMagnitude: {
			Label: Максимальная магнитуда
			Tooltip:
				'''
				Максимальная случайная магнитуда, которая может выпасть (по 10-балльной шкале).
				Минимальная магнитуда всегда 3.
				'''
		}

		EnableAftershocks: {
			Label: Включить афтершоки
			Tooltip: Включить слабые повторные толчки (афтершоки) после основного землетрясения.
		}

		AftershockPeriodSeconds: {
			Label: Период афтершоков (сек.)
			Tooltip: Примерная продолжительность периода афтершоков после основного землетрясения, в секундах.
		}

		ShowChatMessages: {
			Label: Показывать сообщения в чат
			Tooltip: Показывать сообщения в чат о начале и конце землетрясения.
		}

		ShowDebugButton: {
			Label: Показывать кнопку теста
			Tooltip:
				'''
				Показывать на экране кнопку ручного вызова землетрясения (удобно для тестирования).
				Видна только вам, на геймплей других игроков не влияет.
				'''
		}

		DebrisDamageMultiplier: {
			Label: Множитель урона от обломков
			Tooltip: Общий множитель урона от падающих обломков. 1.0 - стандартный урон.
		}

		ImmersiveAudioDucking: {
			Label: Приглушение музыки
			Tooltip: Бонус - во время землетрясения приглушать фоновую музыку, делая акцент на гуле/грохоте.
		}
	}
}

InfoDisplays: {
	SeismographInfoDisplay: {
		DisplayName: Сейсмограф
		Idle: Сейсмограф: {0}
		Warning: Сейсмограф: ГУЛ! ({0})
		Main: ЗЕМЛЕТРЯСЕНИЕ! (Магнитуда {0}/10)
		Aftershock: Сейсмограф: афтершоки
		Unknown: Сейсмограф: --
	}
}

Chat: {
	QuakeStart: Земля начинает трястись под ногами... Магнитуда: {0}/10!
	AftershocksStarting: Основные толчки стихают... но земля ещё может вздрогнуть.
	QuakeEnded: Землетрясение закончилось.
}

UI: {
	ToggleButtonLabel: ЗТ
	PanelTitle: Тест землетрясения
	MagnitudeLabel: Магнитуда:
	TriggerButton: Вызвать!
	TriggerRequestedMessage: "[Тест] Запрошено землетрясение магнитудой {0}"
}
